#!/bin/bash
# دوس دوبل كليك على الملف ده من Finder.
#
# بيعمل حاجتين على فايربيز الحيّ، كل واحدة معاينة الأول وبعدين تأكيد منك:
#   1) ينشر قواعد الأمان اللي في firestore.rules — النسخة المنشورة دلوقتي من
#      2026-08-13 وناقصها أكتر من 120 سطر، من ضمنها القاعدة اللي بتخلّي الستاف
#      يقرا الأوردرات والقاعدة اللي بتخلّي العميل يشوف طلباته القديمة.
#   2) يربط الأوردرات القديمة بحسابات أصحابها بالإيميل (حقل customerAccountId
#      بس — مش بيلمس userId عشان النقاط والكوبونات ما تتأثرش).
#
# الاتنين ليهم رجوع: القواعد القديمة بتتحفظ في .backups/ ومعاها أمر الرجوع.

cd "$(dirname "$0")" || exit 1

echo ""
echo "════════════════════════════════════════════"
echo "  ReklamX — قواعد الأمان + ربط الطلبات"
echo "════════════════════════════════════════════"
echo ""
echo "المجلد: $(pwd)"
echo ""

if [ ! -f service-account.json ]; then
  echo "❌ ملف service-account.json مش موجود — مينفعش نكمل."
  echo ""
  read -r -p "اضغط Enter للخروج..."
  exit 1
fi

# ─────────────────────────── 1) قواعد الأمان ───────────────────────────
echo "الجزء 1 من 2 — قواعد الأمان"
echo "════════════════════════════════════════════"
echo ""
echo "معاينة (مش هيتنشر أي حاجة):"
echo "────────────────────────────────────────────"
if ! node scripts/deploy-rules.mjs; then
  echo ""
  echo "❌ المعاينة فشلت — مفيش حاجة اتنشرت. ابعت الرسالة اللي فوق للمساعد."
  echo ""
  read -r -p "اضغط Enter للخروج..."
  exit 1
fi

echo ""
echo "  لو كمّلت: القواعد القديمة هتتحفظ في .backups/ والأمر اللي يرجّعها"
echo "  هيتطبع لك في آخر السطور."
echo ""
read -r -p "تنشر قواعد الأمان؟ اكتب  yes  وبعدين Enter (أي حاجة تانية = تخطّي): " ANSWER_RULES
echo ""

if [ "$ANSWER_RULES" = "yes" ]; then
  echo "بينشر:"
  echo "────────────────────────────────────────────"
  if node scripts/deploy-rules.mjs --apply; then
    echo ""
    echo "✅ القواعد اتنشرت."
  else
    echo ""
    echo "❌ النشر فشل — القواعد القديمة لسه شغالة زي ما هي."
  fi
else
  echo "تمام — القواعد ما اتغيّرتش."
fi

# ─────────────────────────── 2) ربط الطلبات ───────────────────────────
echo ""
echo ""
echo "الجزء 2 من 2 — ربط الأوردرات القديمة بأصحابها"
echo "════════════════════════════════════════════"
echo ""
echo "معاينة (مش هيتكتب أي حاجة):"
echo "────────────────────────────────────────────"
if ! node scripts/link-guest-orders.mjs; then
  echo ""
  echo "❌ المعاينة فشلت — مفيش حاجة اتكتبت."
  echo ""
  read -r -p "اضغط Enter للخروج..."
  exit 1
fi

echo ""
read -r -p "تكمّل وتربط الأوردرات؟ اكتب  yes  وبعدين Enter (أي حاجة تانية = تخطّي): " ANSWER_LINK
echo ""

if [ "$ANSWER_LINK" = "yes" ]; then
  echo "بيكتب:"
  echo "────────────────────────────────────────────"
  if node scripts/link-guest-orders.mjs --apply; then
    echo ""
    echo "✅ الربط خلص."
  else
    echo ""
    echo "❌ الربط فشل — ابعت الرسالة اللي فوق للمساعد."
  fi
else
  echo "تمام — الأوردرات ما اتغيّرتش."
fi

echo ""
echo "════════════════════════════════════════════"
echo "  بعد كده: افتح http://localhost:3000/customer-dashboard"
echo "  بحساب الأدمن بتاعك والأوردر المفروض يبان."
echo "════════════════════════════════════════════"
echo ""
read -r -p "اضغط Enter لقفل الشباك..."
