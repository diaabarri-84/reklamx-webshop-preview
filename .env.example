# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── AI assistant ───────────────────────────────────────────────────────────
# Server-side only. Never exposed to the browser (see the note in vite.config.ts).
GEMINI_API_KEY=

# ── Payments: Mollie ───────────────────────────────────────────────────────
# From the Mollie dashboard: Developers → API access tokens.
#   test_…  sandbox. No real money moves. Use this until go-live.
#   live_…  real money. Only once the shop is ready to trade.
# Without it the shop still quotes prices and takes orders, and says plainly
# that online payment is unavailable — it never pretends an order was paid.
MOLLIE_API_KEY=

# The shop's own public address, e.g. https://reklamx.se
# Mollie has to REACH the webhook to tell us a payment succeeded, so on localhost
# there is nothing to register: the server omits the webhook and the order page
# polls instead. Set this in production, or payments will never be confirmed.
PUBLIC_URL=

# ── Firebase Admin ─────────────────────────────────────────────────────────
# Needed to write orders and set roles. The server looks for, in order:
#   1. FIREBASE_SERVICE_ACCOUNT — the whole JSON on one line (for PaaS secrets)
#   2. GOOGLE_APPLICATION_CREDENTIALS — a path to the file
#   3. ./service-account.json — the local development file (gitignored)
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Order emails (SMTP) ────────────────────────────────────────────────────
# The shop runs on Google Workspace, so this is Google's own SMTP — no extra
# sending service. Two emails go out the moment a payment is confirmed: a
# confirmation to the customer, and a notification to the shop.
#
# SMTP_PASSWORD MUST BE AN APP PASSWORD, not the account password. Google refuses
# a normal password over SMTP on any account with 2-step verification:
#   myaccount.google.com → Security → App passwords
#
# Port 465 is implicit TLS, 587 upgrades with STARTTLS. Mismatching the port and
# the mode is the usual reason SMTP appears to hang.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@reklamx.se
SMTP_PASSWORD=
# What the customer sees as the sender. Defaults to SMTP_USER.
SMTP_FROM=info@reklamx.se
# Where the shop is told a paid order arrived.
SHOP_ORDER_INBOX=order@reklamx.se

# ── Hosting ────────────────────────────────────────────────────────────────
# Most hosts inject this themselves; the server honours it and falls back to 3000.
# PORT=3000

# Which network address the server answers on.
#   unset / 0.0.0.0  reachable from outside — what a real host needs
#   127.0.0.1        this machine only. Correct for local development, and for a
#                    VPS where nginx on the SAME machine proxies to it. Anywhere
#                    else it makes the site unreachable while the process looks
#                    perfectly healthy, which is a very slow thing to debug.
# HOST=0.0.0.0

# MUST be set to production on the server. Left unset, the server starts an
# in-process Vite DEVELOPMENT server instead of serving the built dist/: pages
# are compiled on demand, the TypeScript source of the admin panel and the
# pricing logic is readable by anyone, and the HSTS security header is never
# sent. It still "works" on the first page load, which is why it gets missed.
# NODE_ENV=production

# Set to 1 ONLY when something else terminates HTTPS in front of the app —
# nginx, Apache, Cloudflare, a platform router. It tells the rate limiter to
# read the real client IP from X-Forwarded-For.
#   Behind a proxy and unset: every customer counts as the same IP, so the whole
#   shop shares one bucket of 120 quotes a minute and real buyers get "Too many
#   requests" at checkout.
#   Exposed directly and set to 1: anyone can forge the header and bypass every
#   limit, including on the paid AI endpoint.
# TRUST_PROXY=1

# ── Firebase (optional overrides) ──────────────────────────────────────────
# The browser config in firebase-applet-config.json is the source of truth for
# all three. Set these only to point a deployment at a different project or
# database without editing that file.
# FIREBASE_PROJECT_ID=
# FIREBASE_DATABASE_ID=
# FIREBASE_API_KEY=

# ── The stage-sweep cron secret ─────────────────────────────────────────────
# The automatic order-stage sweep runs as a setInterval inside the server, and
# ALSO as an endpoint the host's cron calls every 15 minutes, so orders keep
# advancing across a Passenger restart:
#
#     */15 * * * *  curl -s -H "Authorization: Bearer $CRON_SECRET" \
#                        https://shop.reklamx.se/api/cron/auto-stages
#
# Generate one with:  openssl rand -hex 32
#
# Without it the endpoint refuses to run at all — it advances real customers'
# orders and spends the Firestore read quota, so an open one would be both a
# tampering hole and a way to bill the shop. Not needed locally.
CRON_SECRET=

# ── Zendr (shipping) ───────────────────────────────────────────────────────
# Zendr shipping — the API user created in portal.zendr.se on 2026-08-27.
# WIRED UP on 2026-08-29 from the OpenAPI specification the owner exported
# (Zendr API v1.0.6). What the API can do: create order DRAFTS and report
# tracking. What it cannot do: BOOK a shipment or quote a price — booking stays
# a human pressing the button in the portal, and shipping prices are still the
# fixed fees in PRICING_DEFAULTS.shippingFees.
#
# The key below is a PRODUCTION key: it authenticates against api.zendr.se and
# is rejected by test-api.zendr.se ("Integration not found"). It also crossed
# WhatsApp, so it should be rotated in the portal.
ZENDR_API_KEY=

# test  = every call goes to test-api.zendr.se (needs a key made there)
# unset = production, api.zendr.se — where the shop's real freight lives.
ZENDR_MODE=
# Only to point at something other than the two Zendr hosts. Normally empty.
ZENDR_API_BASE=
# Where a created draft is opened and booked by hand.
ZENDR_PORTAL_URL=https://portal.zendr.se

# THE SHOP'S OWN ADDRESS — every shipment is sent FROM here.
#
# REQUIRED, and not yet known: settings/siteConfig.companyAddress is empty in
# Firestore, so there is nothing to copy. Until the street, postcode and town
# are filled in, no draft is created and the back office says exactly that.
ZENDR_SENDER_NAME=ReklamX
ZENDR_SENDER_COMPANY=ReklamX AB
ZENDR_SENDER_EMAIL=info@reklamx.se
ZENDR_SENDER_PHONE=+46 40 614 30 30
ZENDR_SENDER_ADDRESS1=
ZENDR_SENDER_POSTAL_CODE=
ZENDR_SENDER_POSTAL_TOWN=
ZENDR_SENDER_COUNTRY=SE

# The parcel a draft carries when nothing better is known: LxWxH in centimetres,
# then kilograms. Printed goods are made to order and the catalogue records no
# weights, so whoever books the shipment adjusts it in the portal. A plausible
# parcel beats an empty one — an empty draft cannot be booked at all.
ZENDR_DEFAULT_PACKAGE=40x30x20,5
