# ─────────────────────────────────────────────────────────────────────────────
# The shop's environment on the cPanel server.
#
# Copy to  /home/shopreklam/reklamx/.env  and fill in the real values. This file
# is a TEMPLATE and is committed; the real one is not, and must be chmod 600.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# PORT and HOST are deliberately absent.
#
# Under cPanel/Passenger the platform hands the app a unix socket path in PORT
# and there is nothing to bind a host to. Setting either by hand makes the app
# listen somewhere Passenger is not looking, and the site answers 503 with a
# perfectly healthy process behind it.
#
# On a plain VPS with PM2 instead, set:  PORT=3060  and  HOST=127.0.0.1
# (see deploy/ecosystem.config.cjs).

# Passenger puts the app to sleep when nobody is browsing, and the internal
# stage timer sleeps with it — so the schedule runs from a cron job that calls
# /api/cron/auto-stages, and this is the secret that authorises it.
#   openssl rand -hex 32
CRON_SECRET=

# The address customers actually type. Mollie builds its return URL and its
# payment webhook from this, so a wrong value means a paid order that is never
# marked paid.
PUBLIC_URL=https://shop.reklamx.se

# ── Firebase ────────────────────────────────────────────────────────────────
# Either upload service-account.json next to this file (chmod 600), or paste
# the whole JSON on one line here. The file is simpler on cPanel.
# FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
FIREBASE_API_KEY=

# ── Payments ────────────────────────────────────────────────────────────────
MOLLIE_API_KEY=

# ── Order e-mail ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SHOP_ORDER_INBOX=

# ── Shipping (Zendr) ────────────────────────────────────────────────────────
ZENDR_API_KEY=
ZENDR_PORTAL_URL=https://portal.zendr.se
ZENDR_DEFAULT_PACKAGE=40x30x20,5
ZENDR_SENDER_NAME=ReklamX
ZENDR_SENDER_COMPANY=ReklamX AB
ZENDR_SENDER_EMAIL=info@reklamx.se
ZENDR_SENDER_PHONE=+46 40 614 30 30
ZENDR_SENDER_ADDRESS1=Flintyxegatan 9
ZENDR_SENDER_POSTAL_CODE=21376
ZENDR_SENDER_POSTAL_TOWN=Malmö
ZENDR_SENDER_COUNTRY=SE

